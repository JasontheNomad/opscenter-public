{
	"name": "opscenter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"start": "BODY_SIZE_LIMIT=25M node --env-file=.env build",
		"deploy": "npm run build && npm run restart",
		"restart": "if command -v launchctl >/dev/null 2>&1; then launchctl kickstart -k gui/$(id -u)/com.opscenter; else systemctl --user restart opscenter; fi"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"eslint": "^10.10.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@azure/communication-calling": "^1.46.1",
		"@azure/communication-calling-effects": "^1.3.2",
		"@azure/communication-common": "^2.5.0",
		"@azure/communication-identity": "^1.3.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@lezer/highlight": "^1.2.3",
		"better-sqlite3": "^13.0.3",
		"codemirror": "^6.0.2",
		"dompurify": "^3.4.15",
		"marked": "^18.0.12",
		"svelte-dnd-action": "^0.9.79"
	}
}
